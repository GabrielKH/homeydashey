<?xml version="1.0" encoding="utf-8"?>
<!-- Homey is often reached by its LAN IP over plain HTTP, and Android can't scope
     cleartext to private IP ranges, so cleartext is allowed app-wide. The app only
     ever talks to the Homey address the user entered. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
